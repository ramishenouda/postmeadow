# Copy to .env.local and adjust.

# Public URL of the app (used in email links)
APP_URL=http://localhost:3000

# Auth secret: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-random-32+-char-string-openssl-rand

# Postgres (docker compose exposes it on 5433)
DATABASE_URL=postgres://newsletter:newsletter@localhost:5433/newsletter

# Email transport: "smtp" (Mailpit in dev) or "resend" (production)
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# RESEND_API_KEY=re_...

# Default sender for system emails (magic links, confirmations)
EMAIL_FROM="Newsletter <no-reply@localhost>"
