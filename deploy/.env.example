# Production settings. Copy to /opt/postmeadow/.env on the server and fill in.
# Keep this file private: chmod 600 .env

# ─── Server ──────────────────────────────────────────────────────────────────
SITE_DOMAIN=postmeadow.com
APP_URL=https://postmeadow.com
# Image to run; the deploy workflow pins this to the exact build it deploys.
APP_IMAGE=ghcr.io/ramishenouda/postmeadow:latest

# Generate both with: openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Caddy sends the visitor's real IP in this header (see Caddyfile).
CLIENT_IP_HEADER=x-real-ip

# ─── Email (Resend) ──────────────────────────────────────────────────────────
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
# An address on your verified Resend domain.
EMAIL_FROM="Postmeadow <hello@postmeadow.com>"
# Webhook {APP_URL}/api/webhooks/resend (bounces, complaints, opens, clicks)
RESEND_WEBHOOK_SECRET=

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# Leave empty to run without billing (everyone on Free).
STRIPE_SECRET_KEY=
# Webhook {APP_URL}/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
