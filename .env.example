# Copy to .env.local and adjust.

# Public URL of the app (used in email links)
APP_URL=http://localhost:3000

# Auth secret: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-random-32+-char-string-openssl-rand

# Postgres (docker compose exposes it on 5433)
DATABASE_URL=postgres://newsletter:newsletter@localhost:5433/newsletter

# Email transport: "smtp" (Mailpit in dev) or "resend" (production)
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# RESEND_API_KEY=re_...

# Resend webhook signing secret (whsec_...). Point the webhook at
# {APP_URL}/api/webhooks/resend with the email.bounced, email.complained,
# email.suppressed, email.failed, email.opened and email.clicked events.
# Without it, bounces and open/click stats aren't tracked.
# RESEND_WEBHOOK_SECRET=whsec_...

# Stripe billing (optional: without it the app runs with everyone on Free).
# Use test-mode keys while developing, then run `npm run stripe:setup` once to
# create the Postmeadow products and prices. Webhook endpoint: {APP_URL}/api/webhooks/stripe
# Locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# How often the built-in scheduler checks for due scheduled posts and interrupted
# sends (milliseconds). 0 turns it off.
# SCHEDULER_INTERVAL_MS=30000

# Where uploaded images are stored on this server. In production, put this on a
# persistent, backed-up volume (shared by all instances if you run more than one).
# STORAGE_DIR=./storage

# Header your host sets with the real client IP, used for rate limiting.
# Vercel: x-real-ip · Fly.io: fly-client-ip · Cloudflare: cf-connecting-ip
# CLIENT_IP_HEADER=

# Default sender for system emails (magic links, confirmations)
EMAIL_FROM="Postmeadow <no-reply@localhost>"
