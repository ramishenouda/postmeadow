# Production settings. Copy to /opt/postmeadow/.env on the server and fill in.
# Keep this file private: chmod 600 .env

# ─── Server ──────────────────────────────────────────────────────────────────
SITE_DOMAIN=postmeadow.com
APP_URL=https://postmeadow.com
# Image to run; the deploy workflow pins this to the exact build it deploys.
APP_IMAGE=ghcr.io/ramishenouda/postmeadow:latest

# Generate both with: openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Caddy sends the visitor's real IP in this header (see Caddyfile).
CLIENT_IP_HEADER=x-real-ip

# ─── Email (Resend) ──────────────────────────────────────────────────────────
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
# An address on your verified Resend domain.
EMAIL_FROM="Postmeadow <hello@postmeadow.com>"
# Webhook {APP_URL}/api/webhooks/resend (bounces, complaints, opens, clicks)
RESEND_WEBHOOK_SECRET=

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# Leave empty to run without billing (everyone on Free).
STRIPE_SECRET_KEY=
# Webhook {APP_URL}/api/webhooks/stripe (also readers' paid subscriptions, and
# account.updated from connected accounts)
STRIPE_WEBHOOK_SECRET=

# ─── Publications' own domains ───────────────────────────────────────────────
# Where writers point their CNAME (e.g. domains.postmeadow.com, an A record to this
# server). Empty = the site's own host name.
CUSTOM_DOMAIN_TARGET=

# ─── Admin and monitoring ────────────────────────────────────────────────────
# Who can open /admin (comma-separated). Also receives abuse alerts.
ADMIN_EMAILS=
# Sentry project DSN (sentry.io → Project settings → Client keys). Empty = off.
SENTRY_DSN=

# ─── Off-site backups (any S3-compatible storage) ────────────────────────────
# Leave BACKUP_S3_BUCKET empty to keep backups on this server only.
# Examples of BACKUP_S3_ENDPOINT:
#   Backblaze B2:   https://s3.eu-central-003.backblazeb2.com
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
#   Hetzner:        https://fsn1.your-objectstorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Encrypts everything off-site. Generate with: openssl rand -base64 32
# Store a copy outside this server (a password manager): without it, backups can't be restored.
BACKUP_PASSPHRASE=
