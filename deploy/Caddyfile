# Caddy terminates HTTPS (certificates from Let's Encrypt, renewed automatically)
# and forwards to the app. SITE_DOMAIN comes from .env, e.g. postmeadow.com.

{
	# Publications' own domains get certificates on demand, but only for domains a
	# writer has verified in Settings (the app answers 200 for those).
	on_demand_tls {
		ask http://app:3000/api/domains/check
	}
}
{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Framing rules are set by the app (next.config.ts): only /embed/ may be framed.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy app:3000 {
		# The client's real IP, for rate limiting (CLIENT_IP_HEADER=x-real-ip).
		header_up X-Real-IP {remote_host}
		# Stream pages as they render (React Suspense) instead of buffering.
		flush_interval -1
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Every other host name: a publication's own domain (news.brand.com). The app serves
# the right publication for the Host header (src/proxy.ts).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		flush_interval -1
	}
}
